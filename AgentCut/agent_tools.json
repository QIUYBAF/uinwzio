{
  "name": "AgentCut",
  "version": "1.0.1",
  "release_status": "stable_remaster",
  "protocol_version": 5,
  "canonical_state": "project.json",
  "preferred_agent_gateway": {
    "bootstrap": "GET /agent/bootstrap",
    "context": "GET /agent/context",
    "schema": "GET /agent/operation-schema",
    "preflight": "POST /agent/preflight",
    "apply": "POST /agent/apply",
    "strict_fallback": "POST /operations/transaction"
  },
  "recommended_agent_loop": [
    "GET /agent/bootstrap first on restart/upgrade",
    "request only task-scoped context when needed",
    "POST /agent/preflight",
    "review repairs + impact + verification",
    "POST /agent/apply with expected_project_hash",
    "render recommended proxy scope",
    "QA + inspect",
    "export-plan/export only at delivery"
  ],
  "reliability": {
    "flexible_operation_shapes": true,
    "deterministic_alias_normalization": true,
    "ambiguous_creative_autocorrection": false,
    "compact_preflight": true,
    "change_impact_map": true,
    "verification_plan": true,
    "optimistic_concurrency": true,
    "persistent_resume_capsule": true,
    "exact_schema_delta_on_upgrade": true,
    "scene_specific_cast_staging": true,
    "smart_srt_speaker_recovery": true,
    "editorial_coverage_qa": true
  },
  "efficiency": {
    "task_scoped_context": true,
    "warm_bootstrap": true,
    "local_render_scope_planning": true,
    "local_telemetry_without_payload_retention": true,
    "real_codex_billing_savings_claimed": false
  },
  "performance": {
    "cast_registry": true,
    "dialogue_scene_recipe": true,
    "speaker_tracking": true,
    "dialogue_coverage": true,
    "attention_insert": true,
    "auto_long_dialogue_coverage": true,
    "beat_aligned_focus": true,
    "reaction_shots": true,
    "anonymous_visual_staging_anchors": true,
    "explicit_order_staging": true
  },
  "subtitles": {
    "structured_bilingual": true,
    "srt_import": true,
    "automatic_asr": "optional_whisper.cpp",
    "auto_fit_layout": true,
    "split_recommended_guard": true,
    "asr_one_command_windows_x64": true,
    "asr_default_model": "tiny-q5_1"
  },
  "gen3": {
    "enabled": true,
    "semantic_scene_grammar": true,
    "tile_extract_stitch": true,
    "actor_card_matte": true,
    "remotion_bridge_schema": "agentcut-gen3-remotion-v2",
    "remotion_bridge_integrity_verified": true,
    "fresh_npm_chromium_install_verified_in_release_validation": false
  },
  "render": {
    "official_ceiling": "3840x2160@60fps",
    "flexible_export": true,
    "containers": ["mp4", "mov", "mkv", "webm"],
    "video_codecs": ["h264", "hevc", "av1", "vp9", "prores"],
    "runtime_nvenc_probe": true,
    "shot_path": true,
    "shot_path_keyframe_limit": 24,
    "deterministic_ffmpeg_pillow_fallback": true
  },
  "enhancement": {
    "bundled_realesrgan_windows_linux": false,
    "bundled_models": [],
    "rife_external_optional": true,
    "fallback_never_reported_as_ai": true
  },
  "deployment": {
    "priority": "P0",
    "target_release": "1.0.1",
    "direct_checkout_runner": "python AgentCut/run.py",
    "one_command": "agentcut quickstart PROJECT --create",
    "github_source_complete": true,
    "backend_auto": true,
    "optional_heavy_dependencies_bundled": false
  }
}
